# DeVore Studio — Environment Variables
#
# Never commit a real .env.local file or real credentials. Store actual
# secrets in 1Password and in Vercel's Environment Variables settings.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser —
# never put server-only secrets behind that prefix.

# --- Site URL (required in production) ---
# Falls back to http://localhost:3000 in development only. Before
# launch, this MUST be set to the project's real production domain in
# Vercel's Environment Variables — see docs/LAUNCH-CHECKLIST.md. Used
# for canonical URLs, Open Graph tags, and the generated sitemap/robots.
# Must be an absolute URL including the protocol (e.g.
# https://example.com, not example.com) — a value without a protocol
# will crash the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Estimate request delivery (required for the estimate form to send) ---
# Used by src/app/api/estimate/route.ts. Without RESEND_API_KEY and
# ESTIMATE_FROM_EMAIL set, that endpoint returns a clear "not configured"
# error instead of pretending to send anything — see the production-
# readiness report for what still needs to happen in the Resend/Vercel
# dashboards before these are real.
#
# RESEND_API_KEY: server-only secret from the Resend dashboard. Never
# expose this with a NEXT_PUBLIC_ prefix, in client code, or in a real
# committed .env file — set it in Vercel's Environment Variables and/or
# 1Password only.
RESEND_API_KEY=

# ESTIMATE_FROM_EMAIL: the authenticated sender address, e.g.
# estimates@<production-domain>. Must be on a domain that has been
# added and verified (SPF/DKIM) in Resend — sending from an
# unauthenticated domain will fail or land in spam. Do not set this to
# pdillardpainting2000@yahoo.com or any address DeVore Studio doesn't
# control; the reply-to (not the sender) is what carries the
# customer's address, so this can and should be a project-controlled
# address like estimates@percydillardpainting.com once the production
# domain is chosen.
ESTIMATE_FROM_EMAIL=

# ESTIMATE_TO_EMAIL: where estimate requests are delivered. Defaults to
# pdillardpainting2000@yahoo.com in code if unset, but set it here
# explicitly so it's visible in Vercel's project settings rather than
# implicit in source.
ESTIMATE_TO_EMAIL=pdillardpainting2000@yahoo.com

# --- Optional integrations ---
# Nothing below is required. Only uncomment and set variables that a
# given project actually uses, once that integration has been
# deliberately added — the Supabase SDK is NOT installed in this
# starter, and Resend is used above via a plain fetch call rather than
# its SDK, so no Resend package is installed either.

# Supabase (optional — only if this project uses a database, auth, or
# storage; e.g. if project photo uploads move to external storage —
# see the estimate form's photo-strategy notes before adding this)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
