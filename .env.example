# DeVore Studio — Environment Variables
#
# Never commit a real .env.local file or real credentials. Store actual
# secrets in 1Password and in Vercel's Environment Variables settings.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser —
# never put server-only secrets behind that prefix.

# --- Site URL (required in production) ---
# Falls back to http://localhost:3000 in development only. Before
# launch, this MUST be set to the project's real production domain in
# Vercel's Environment Variables — see docs/LAUNCH-CHECKLIST.md. Used
# for canonical URLs, Open Graph tags, and the generated sitemap/robots.
# Must be an absolute URL including the protocol (e.g.
# https://example.com, not example.com) — a value without a protocol
# will crash the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional integrations ---
# Nothing below is required. Only uncomment and set variables that a
# given project actually uses, once that integration has been
# deliberately added — Supabase and Resend SDKs are NOT installed in
# this starter.

# Supabase (optional — only if this project uses a database or auth)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (optional — only if this project sends transactional email)
# RESEND_API_KEY=
